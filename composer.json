{
    "name": "jankado-official/jankado-laravel",
    "description": "Official Laravel SDK for the Jankado API.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Jankado\\Sdk\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jankado\\Sdk\\JankadoServiceProvider"
            ],
            "aliases": {
                "Jankado": "Jankado\\Sdk\\Facades\\Jankado"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
